# ============ 服务 ============
RAG_HOST=127.0.0.1
RAG_PORT=8000
# 可选：给 /api 加 Bearer Token（留空则不校验）
RAG_API_TOKEN=

# ============ 对话模型（OpenAI 兼容）============
# 预设：glm | mx | kkrich | custom（custom 时直接填 LLM_BASE_URL/LLM_API_KEY）
LLM_PRESET=glm
LLM_MODEL=glm-4-flash
# LLM_BASE_URL=
# LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# ============ 向量模型（OpenAI 兼容 /v1/embeddings）============
# 填任意支持 OpenAI embeddings 协议的服务，例如硅基流动、智谱、OpenAI、本地 vLLM 等
# 留空/ custom 表示手动填写；填 glm 可复用 GLM_API_KEY
EMBED_PRESET=custom
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
EMBED_BATCH=32

# ============ 检索 ============
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_VECTOR=20
TOP_K_KEYWORD=20
FINAL_K=6
MAX_CONTEXT_CHARS=6000
QUERY_REWRITE=true
